__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/
data/*.sqlite3
data/*.db
experiments/
*.log
videotracker/
models/*.pt
models/*.pth
models/*.onnx
models/*.engine

# 本地研究资料、测试视频和架构文档不上传远程仓库
/docs/
/research results/
/research results/repair.md
/research results/gait_registration_problem_analysis.md
/research results/步态识别_跨视角ID分裂与短期步态误识别解决方案.md
