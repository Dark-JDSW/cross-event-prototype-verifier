{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cross-event-rgb-gait-v1/source_metadata.schema.json",
  "title": "MEVID source-to-video metadata required before manifest construction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_key",
    "annotation_split",
    "track_index",
    "source_video_id",
    "source_video_path",
    "source_video_sha256",
    "source_video_frame_count",
    "raw_frame_start",
    "raw_frame_end",
    "fps",
    "capture_session_id",
    "capture_period",
    "camera_id",
    "view_condition",
    "walking_verified",
    "walking_direction",
    "load_condition",
    "consent_id",
    "license_status",
    "manual_review_id",
    "metadata_version"
  ],
  "properties": {
    "track_key": {"type": "string", "pattern": "^(train|test):[0-9]+$"},
    "annotation_split": {"type": "string", "enum": ["train", "test"]},
    "track_index": {"type": "integer", "minimum": 0},
    "source_video_id": {"type": "string", "minLength": 1},
    "source_video_path": {"type": "string", "minLength": 1},
    "source_video_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_video_frame_count": {"type": "integer", "minimum": 1},
    "raw_frame_start": {"type": "integer", "minimum": 0},
    "raw_frame_end": {"type": "integer", "minimum": 0},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "capture_session_id": {"type": "string", "minLength": 1},
    "capture_period": {"type": "string", "minLength": 1},
    "camera_id": {"type": "string", "minLength": 1},
    "view_condition": {"type": "string", "enum": ["side", "oblique", "front", "back", "transition", "unknown"]},
    "walking_verified": {"type": "boolean"},
    "walking_direction": {"type": "string", "enum": ["approaching", "leaving", "lateral", "unknown"]},
    "load_condition": {"type": "string", "minLength": 1},
    "occlusion_level": {"type": "string"},
    "adverse_quality_condition": {"type": "string"},
    "consent_id": {"type": "string", "minLength": 1},
    "license_status": {"type": "string", "const": "approved_for_this_use"},
    "manual_review_id": {"type": "string", "minLength": 1},
    "metadata_version": {"type": "string", "minLength": 1}
  }
}
