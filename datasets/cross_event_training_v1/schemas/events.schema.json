{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cross-event-rgb-gait-v1/events.schema.json",
  "title": "Cross-event RGB gait event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "identity_id",
    "capture_session_id",
    "camera_id",
    "source_video_id",
    "video_path",
    "video_sha256",
    "fps",
    "frame_count",
    "frame_start",
    "frame_end",
    "capture_period",
    "clothing_condition_id",
    "load_condition",
    "view_conditions",
    "walking_direction",
    "split",
    "consent_id",
    "source_track_key",
    "tracks_path",
    "poses_dir"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "identity_id": {"type": "string", "minLength": 1},
    "capture_session_id": {"type": "string", "minLength": 1},
    "camera_id": {"type": "string", "minLength": 1},
    "source_video_id": {"type": "string", "minLength": 1},
    "video_path": {"type": "string", "minLength": 1},
    "video_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "frame_count": {"type": "integer", "minimum": 1},
    "frame_start": {"type": "integer", "minimum": 0},
    "frame_end": {"type": "integer", "minimum": 0},
    "capture_period": {"type": "string", "minLength": 1},
    "clothing_condition_id": {"type": "string", "minLength": 1},
    "load_condition": {"type": "string", "minLength": 1},
    "view_conditions": {
      "type": "array",
      "items": {"type": "string", "enum": ["side", "oblique", "front", "back", "transition", "unknown"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "walking_direction": {"type": "string", "enum": ["approaching", "leaving", "lateral", "unknown"]},
    "split": {"type": "string", "enum": ["train-dev", "calibration-known", "calibration-unknown", "locked-test-known", "locked-test-unknown"]},
    "consent_id": {"type": "string", "minLength": 1},
    "source_track_key": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "chip_frame_count": {"type": "integer", "minimum": 1},
    "tracks_path": {"type": "string", "minLength": 1},
    "poses_dir": {"type": "string", "minLength": 1},
    "load_condition_detail": {"type": "string"},
    "occlusion_level": {"type": "string"},
    "adverse_quality_condition": {"type": "string"},
    "manual_review_id": {"type": "string"},
    "metadata_version": {"type": "string", "minLength": 1},
    "event_status": {"type": "string", "enum": ["metadata_complete_pose_pending", "production_ready"]}
  }
}
